{
  "name": "sharpcrackers",
  "account_id": "935bb52ad0d38d6974289e4a94ff49c2",
  "main": "./worker.js",
  "compatibility_date": "2024-09-23",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sharpcrackers_db",
      "database_id": "3a82141a-f116-4a3e-87c8-eef51ce157e4"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "order-images"
    }
  ],
  "triggers": {
    "crons": ["0 3 * * *"]
  }
}
